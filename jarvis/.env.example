# J.A.R.V.I.S. backend configuration
# Copy this file to `.env` in the repo root (or in backend/, whichever your
# shell is run from) and fill in the values you need. Every setting below
# has a working default in app/config.py EXCEPT OpenRouter's API key.

# -----------------------------------------------------------------------
# REQUIRED — the only setting you must provide.
# -----------------------------------------------------------------------

# Get a free key at https://openrouter.ai/keys (no credit card required for
# the free-tier models used by this project). Without this key set, the
# backend still starts, but any chat/planning/vision LLM call will fail
# with a clear error at call time.
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------
# OPTIONAL — LLM provider
# -----------------------------------------------------------------------

# OpenRouter-compatible API base URL. Change only if you're proxying
# OpenRouter or pointing at a compatible gateway.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ordered model fallback chains (comma-separated). The agent tries each
# model in order, falling back on rate limits/errors. Defaults below match
# docs/CONTRACTS.md section 5 (all free-tier OpenRouter models).
PLANNING_MODELS=deepseek/deepseek-r1:free,qwen/qwen3-235b-a22b:free,meta-llama/llama-3.3-70b-instruct:free
CHAT_MODELS=deepseek/deepseek-r1:free,qwen/qwen3-235b-a22b:free,meta-llama/llama-3.3-70b-instruct:free
VISION_MODELS=qwen/qwen2.5-vl-32b-instruct:free,meta-llama/llama-3.2-11b-vision-instruct:free

# -----------------------------------------------------------------------
# OPTIONAL — storage
# -----------------------------------------------------------------------

# Root directory the agent's file tools are sandboxed to. Created
# automatically if it doesn't exist. Defaults to ~/jarvis-workspace.
WORKSPACE_ROOT=~/jarvis-workspace

# SQLite database files for long-term memory and background tasks.
MEMORY_DB_PATH=~/jarvis-workspace/memory.db
TASKS_DB_PATH=~/jarvis-workspace/tasks.db

# -----------------------------------------------------------------------
# OPTIONAL — server
# -----------------------------------------------------------------------

HOST=127.0.0.1
PORT=8000

# Comma-separated list of allowed CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------
# OPTIONAL — sensing / features
# -----------------------------------------------------------------------

# How often (ms) the backend pushes unprompted `telemetry` WS events.
TELEMETRY_INTERVAL_MS=1000

# Toggle webcam vision processing (face/hand/OCR/scene) and voice features
# entirely. Useful on machines without a camera/mic or the heavy vision
# deps (opencv/mediapipe/rapidocr) installed.
VISION_ENABLED=true
VOICE_ENABLED=true

# -----------------------------------------------------------------------
# OPTIONAL — memory / embeddings
# -----------------------------------------------------------------------

# sentence-transformers model used to embed memories for cosine-similarity
# recall. all-MiniLM-L6-v2 is small, fast, and CPU-friendly.
EMBED_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------
# OPTIONAL — agent loop
# -----------------------------------------------------------------------

# Safety cap on tool-call round trips per turn before the agent loop stops
# and returns whatever it has.
MAX_TOOL_ITERATIONS=8

# -----------------------------------------------------------------------
# OPTIONAL — logging
# -----------------------------------------------------------------------

LOG_LEVEL=INFO
