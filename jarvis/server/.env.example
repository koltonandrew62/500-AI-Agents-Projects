# J.A.R.V.I.S. server configuration
# Copy this file to `.env` and fill in what you need. Every setting below has
# a sane built-in default — the ONLY setting you actually need to set is
# OPENROUTER_API_KEY, and it's free.

# ---------------------------------------------------------------------------
# LLM provider (REQUIRED)
# ---------------------------------------------------------------------------

# Get a free key at https://openrouter.ai/keys — no card required for the
# free-tier ":free" model chains this server uses. Without this set the
# server still boots and answers /health, but chat/vision/planning calls
# will fail with a clear error.
OPENROUTER_API_KEY=

# Override only if you're proxying OpenRouter through something else.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Model chains (comma-separated, fallback order left-to-right)
# Defaults match PORT-CONTRACTS.md §4 — leave unset unless you have a reason.
# ---------------------------------------------------------------------------

# JARVIS_PLANNING_MODELS=deepseek/deepseek-r1:free,qwen/qwen3-235b-a22b:free,meta-llama/llama-3.3-70b-instruct:free
# JARVIS_CHAT_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-235b-a22b:free
# JARVIS_VISION_MODELS=meta-llama/llama-3.2-11b-vision-instruct:free,qwen/qwen2.5-vl-72b-instruct:free

# ---------------------------------------------------------------------------
# Storage — created automatically if missing
# ---------------------------------------------------------------------------

# JARVIS_WORKSPACE_ROOT=~/jarvis-workspace
# JARVIS_MEMORY_DB_PATH=~/jarvis-workspace/memory.db
# JARVIS_TASKS_DB_PATH=~/jarvis-workspace/tasks.db

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# JARVIS_HOST=127.0.0.1
# JARVIS_PORT=8000

# Comma-separated list of allowed CORS origins. Only matters if you're
# serving jarvis.html from somewhere other than this server.
# JARVIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Sensing / features
# ---------------------------------------------------------------------------

# How often (ms) telemetry is broadcast to every connected WebSocket client.
# JARVIS_TELEMETRY_INTERVAL_MS=1000

# JARVIS_VISION_ENABLED=true
# JARVIS_VOICE_ENABLED=true

# ---------------------------------------------------------------------------
# Agent loop
# ---------------------------------------------------------------------------

# Max tool-call round-trips the agent will make in a single turn before
# giving up and answering with whatever it has.
# JARVIS_MAX_TOOL_ITERATIONS=8

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# One of: debug, info, warn, error
# JARVIS_LOG_LEVEL=info
